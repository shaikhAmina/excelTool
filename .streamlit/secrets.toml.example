# ─────────────────────────────────────────────────────────────────────────────
# EXCEL TOOLBOX — Streamlit Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE
# ─────────────────────────────────────────────────────────────────────────────
#
# FOR LOCAL DEVELOPMENT:
#   1. Copy this file and rename the copy to:  .streamlit/secrets.toml
#   2. Fill in your real values below
#   3. secrets.toml is already in .gitignore — it will never be committed
#
# FOR STREAMLIT COMMUNITY CLOUD:
#   1. Go to your app dashboard → ⋮ menu → "Edit secrets"
#   2. Paste the filled-in content of this file (without the comments if you like)
#   3. Click Save — the app restarts and picks up the secrets automatically
#
# ─────────────────────────────────────────────────────────────────────────────
# STEP-BY-STEP: How to get these values
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or use an existing one)
# 3. Enable the following two APIs:
#      - Google Sheets API
#      - Google Drive API
# 4. Go to "IAM & Admin" → "Service Accounts" → "Create Service Account"
#      - Give it any name, e.g. "excel-toolbox-feedback"
#      - Skip optional steps, click Done
# 5. Click the service account → "Keys" tab → "Add Key" → "Create new key" → JSON
#      - A .json file downloads — open it, copy the values into the fields below
# 6. Create a Google Sheet:
#      - Name it anything, e.g. "Excel Toolbox Feedback"
#      - Copy the sheet name exactly into [feedback] sheet_name below
# 7. Share the sheet with the service account email
#      (looks like name@project-id.iam.gserviceaccount.com)
#      Give it "Editor" access
#
# That's it. Submissions will appear as new rows in your sheet automatically.
# ─────────────────────────────────────────────────────────────────────────────

[feedback]
sheet_name = "Excel Toolbox Feedback"   # must match your Google Sheet name exactly

[gcp_service_account]
type                        = "service_account"
project_id                  = "your-project-id"
private_key_id              = "your-private-key-id"
private_key                 = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email                = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id                   = "your-client-id"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
